# ─── Supabase (Auth only — required for accounts) ────────────────────────────
# Get these from https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Google Sheets (primary data store — required for orders/customers) ───────
# 1. Open the Apps Script in Google Sheets (Extensions → Apps Script)
# 2. Paste the contents of supabase/google-apps-script/IDF_CustDetails_sync.gs
# 3. Change SHARED_TOKEN in the .gs file to something random and secret
# 4. Deploy → New Deployment → Type: Web App, Execute as: Me, Anyone
# 5. Copy the Web App URL here
# 6. Set VITE_APPS_SCRIPT_TOKEN to match SHARED_TOKEN in the .gs file
VITE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_TOKEN=idf-change-this-to-something-random-and-secret

# ─── Phone Auth (optional — needs Twilio configured in Supabase) ──────────────
# Set to "true" to show the "Continue with Phone" option in the auth modal.
# Leave blank or "false" if Twilio is not yet connected in your Supabase project.
VITE_ENABLE_PHONE_AUTH=false
