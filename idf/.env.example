# ─── Google Auth (required for customer accounts) ─────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Authorized JavaScript origins: your Vercel URL + http://localhost:5173
# 4. Copy the Client ID below
VITE_GOOGLE_CLIENT_ID=

# ─── Google Sheets (primary data store — required for orders/customers) ───────
# 1. Open the Apps Script in Google Sheets (Extensions → Apps Script)
# 2. Paste the contents of supabase/google-apps-script/IDF_CustDetails_sync.gs
# 3. Change SHARED_TOKEN in the .gs file to something random and secret
# 4. Deploy → New Deployment → Type: Web App, Execute as: Me, Anyone
# 5. Copy the Web App URL here
# 6. Set VITE_APPS_SCRIPT_TOKEN to match SHARED_TOKEN in the .gs file
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyE3T-eq_SvFbp0qmvfrlevVHmNIT3ka9pougCkHmz7lAsSF9aaNanNIebJmGh-9lcOsg/exec
VITE_APPS_SCRIPT_TOKEN=idf-secret-2024

# ─── Supabase (admin panel only — optional but recommended) ───────────────────
# Only VITE_SUPABASE_URL is needed now. The anon key is no longer required
# (Supabase JS client removed; admin Edge Functions are called via plain fetch).
# Without this, the admin panel falls back to PIN login + static catalog.
# 1. Create a project at supabase.com
# 2. SQL Editor → paste supabase/schema.sql → Run
# 3. Deploy admin-auth edge function (see HANDOVER.md §6)
VITE_SUPABASE_URL=

# ─── Razorpay (payment gateway) ───────────────────────────────────────────────
# Get your Key ID from: dashboard.razorpay.com → Account & Settings → API Keys
# The Key Secret goes ONLY in the Google Apps Script backend (IDF_Backend.gs),
# never in frontend code.
VITE_RAZORPAY_KEY_ID=
